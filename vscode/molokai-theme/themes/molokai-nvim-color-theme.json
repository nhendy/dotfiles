{
  "$schema": "vscode://schemas/color-theme",
  "name": "Molokai (nvim)",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#FFFFFF",
    "focusBorder": "#465457",
    "selection.background": "#403D3D",
    "widget.shadow": "#00000080",

    "editor.background": "#1B1D1E",
    "editor.foreground": "#FFFFFF",
    "editorCursor.foreground": "#F8F8F0",
    "editorCursor.background": "#000000",
    "editor.selectionBackground": "#403D3D",
    "editor.inactiveSelectionBackground": "#403D3D99",
    "editor.selectionHighlightBackground": "#403D3D99",
    "editor.wordHighlightBackground": "#403D3D99",
    "editor.wordHighlightStrongBackground": "#403D3DCC",
    "editor.lineHighlightBackground": "#293739",
    "editor.lineHighlightBorder": "#00000000",
    "editor.findMatchBackground": "#FFE792AA",
    "editor.findMatchBorder": "#FFE792",
    "editor.findMatchHighlightBackground": "#FFE79255",
    "editor.rangeHighlightBackground": "#403D3D66",
    "editor.foldBackground": "#00000066",
    "editorLineNumber.foreground": "#465457",
    "editorLineNumber.activeForeground": "#FD971F",
    "editorGutter.background": "#232526",
    "editorGutter.addedBackground": "#A6E22E",
    "editorGutter.modifiedBackground": "#FD971F",
    "editorGutter.deletedBackground": "#F92672",
    "editorGutter.foldingControlForeground": "#465457",
    "editorBracketMatch.background": "#FD971F66",
    "editorBracketMatch.border": "#FD971F",
    "editorWhitespace.foreground": "#465457",
    "editorIndentGuide.background1": "#2E3133",
    "editorIndentGuide.activeBackground1": "#465457",
    "editorRuler.foreground": "#232526",
    "editorCodeLens.foreground": "#7E8E91",
    "editorLink.activeForeground": "#66D9EF",
    "editorInlayHint.foreground": "#7E8E91",
    "editorInlayHint.background": "#23252600",
    "editorGhostText.foreground": "#7E8E91",

    "editorError.foreground": "#FFC0B9",
    "editorWarning.foreground": "#FCE094",
    "editorInfo.foreground": "#8CF8F7",
    "editorHint.foreground": "#A6DBFF",
    "problemsErrorIcon.foreground": "#FFC0B9",
    "problemsWarningIcon.foreground": "#FCE094",
    "problemsInfoIcon.foreground": "#8CF8F7",

    "diffEditor.insertedLineBackground": "#13354A",
    "diffEditor.insertedTextBackground": "#1F5577",
    "diffEditor.removedLineBackground": "#1E0010",
    "diffEditor.removedTextBackground": "#96005066",

    "editorSuggestWidget.background": "#000000",
    "editorSuggestWidget.border": "#232526",
    "editorSuggestWidget.foreground": "#66D9EF",
    "editorSuggestWidget.selectedBackground": "#808080",
    "editorSuggestWidget.selectedForeground": "#FFFFFF",
    "editorSuggestWidget.highlightForeground": "#FD971F",
    "editorSuggestWidget.focusHighlightForeground": "#FFE792",
    "editorHoverWidget.background": "#07080D",
    "editorHoverWidget.border": "#232526",
    "editorWidget.background": "#07080D",
    "editorWidget.border": "#232526",
    "peekView.border": "#FD971F",
    "peekViewEditor.background": "#07080D",
    "peekViewResult.background": "#000000",
    "peekViewTitle.background": "#07080D",
    "peekViewEditor.matchHighlightBackground": "#FFE79255",
    "peekViewResult.matchHighlightBackground": "#FFE79255",

    "quickInput.background": "#07080D",
    "quickInput.foreground": "#FFFFFF",
    "quickInputList.focusBackground": "#403D3D",
    "quickInputList.focusForeground": "#FFFFFF",
    "pickerGroup.foreground": "#FD971F",
    "pickerGroup.border": "#232526",
    "input.background": "#232526",
    "input.foreground": "#FFFFFF",
    "input.border": "#465457",
    "input.placeholderForeground": "#7E8E91",
    "inputOption.activeBorder": "#FD971F",
    "list.highlightForeground": "#FD971F",
    "list.focusHighlightForeground": "#FFE792",
    "list.activeSelectionBackground": "#403D3D",
    "list.activeSelectionForeground": "#FFFFFF",
    "list.inactiveSelectionBackground": "#293739",
    "list.hoverBackground": "#232526",
    "list.focusOutline": "#465457",
    "list.errorForeground": "#FFC0B9",
    "list.warningForeground": "#FCE094",

    "sideBar.background": "#1B1D1E",
    "sideBar.foreground": "#FFFFFF",
    "sideBar.border": "#080808",
    "sideBarTitle.foreground": "#A6E22E",
    "sideBarSectionHeader.background": "#1B1D1E",
    "sideBarSectionHeader.foreground": "#A6E22E",
    "activityBar.background": "#080808",
    "activityBar.foreground": "#FFFFFF",
    "activityBar.inactiveForeground": "#808080",
    "activityBar.border": "#080808",
    "activityBarBadge.background": "#F92672",
    "activityBarBadge.foreground": "#FFFFFF",
    "badge.background": "#F92672",
    "badge.foreground": "#FFFFFF",

    "editorGroup.border": "#465457",
    "editorGroupHeader.tabsBackground": "#1B1D1E",
    "editorGroupHeader.noTabsBackground": "#1B1D1E",
    "tab.activeBackground": "#232526",
    "tab.activeForeground": "#FFFFFF",
    "tab.activeBorderTop": "#FD971F",
    "tab.inactiveBackground": "#1B1D1E",
    "tab.inactiveForeground": "#808080",
    "tab.unfocusedActiveForeground": "#BCBCBC",
    "tab.border": "#1B1D1E",
    "breadcrumb.foreground": "#808080",
    "breadcrumb.focusForeground": "#FFFFFF",
    "breadcrumb.background": "#1B1D1E",

    "statusBar.background": "#FFFFFF",
    "statusBar.foreground": "#455354",
    "statusBar.noFolderBackground": "#FFFFFF",
    "statusBar.noFolderForeground": "#455354",
    "statusBar.debuggingBackground": "#FD971F",
    "statusBar.debuggingForeground": "#000000",
    "statusBar.border": "#080808",
    "statusBarItem.remoteBackground": "#A6E22E",
    "statusBarItem.remoteForeground": "#000000",
    "titleBar.activeBackground": "#080808",
    "titleBar.activeForeground": "#BCBCBC",
    "titleBar.inactiveBackground": "#080808",
    "titleBar.inactiveForeground": "#808080",

    "panel.background": "#1B1D1E",
    "panel.border": "#465457",
    "panelTitle.activeForeground": "#FFFFFF",
    "panelTitle.activeBorder": "#FD971F",
    "panelTitle.inactiveForeground": "#808080",
    "terminal.background": "#1B1D1E",
    "terminal.foreground": "#FFFFFF",
    "terminalCursor.foreground": "#F8F8F0",
    "terminal.selectionBackground": "#403D3D",
    "terminal.ansiBlack": "#1B1D1E",
    "terminal.ansiRed": "#F92672",
    "terminal.ansiGreen": "#A6E22E",
    "terminal.ansiYellow": "#E6DB74",
    "terminal.ansiBlue": "#66D9EF",
    "terminal.ansiMagenta": "#AE81FF",
    "terminal.ansiCyan": "#66D9EF",
    "terminal.ansiWhite": "#E0E2EA",
    "terminal.ansiBrightBlack": "#7E8E91",
    "terminal.ansiBrightRed": "#F92672",
    "terminal.ansiBrightGreen": "#A6E22E",
    "terminal.ansiBrightYellow": "#FD971F",
    "terminal.ansiBrightBlue": "#66D9EF",
    "terminal.ansiBrightMagenta": "#AE81FF",
    "terminal.ansiBrightCyan": "#8CF8F7",
    "terminal.ansiBrightWhite": "#FFFFFF",

    "scrollbarSlider.background": "#46545766",
    "scrollbarSlider.hoverBackground": "#465457AA",
    "scrollbarSlider.activeBackground": "#465457",
    "button.background": "#465457",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#5A6B6E",
    "dropdown.background": "#232526",
    "dropdown.border": "#465457",
    "textLink.foreground": "#66D9EF",
    "textLink.activeForeground": "#A6E22E",
    "notifications.background": "#07080D",
    "notifications.border": "#232526",
    "gitDecoration.addedResourceForeground": "#A6E22E",
    "gitDecoration.modifiedResourceForeground": "#FD971F",
    "gitDecoration.deletedResourceForeground": "#F92672",
    "gitDecoration.untrackedResourceForeground": "#A6E22E",
    "gitDecoration.ignoredResourceForeground": "#465457"
  },

  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#7E8E91" } },
    { "scope": ["comment.block.documentation", "string.quoted.docstring", "string.quoted.docstring.multi"], "settings": { "foreground": "#E6DB74" } },

    { "scope": ["string", "punctuation.definition.string", "string.quoted"], "settings": { "foreground": "#E6DB74" } },
    { "scope": ["constant.character.escape", "constant.character.format.placeholder", "constant.other.placeholder", "string.regexp keyword.control"], "settings": { "foreground": "#F92672", "fontStyle": "bold" } },
    { "scope": ["constant.numeric", "constant.language.boolean", "constant.language.python"], "settings": { "foreground": "#AE81FF" } },
    { "scope": ["constant.language.null", "constant.language.undefined", "constant.language.none"], "settings": { "foreground": "#66D9EF", "fontStyle": "italic" } },
    { "scope": ["variable.other.constant", "constant.other", "variable.other.enummember", "constant.other.caps"], "settings": { "foreground": "#AE81FF", "fontStyle": "bold" } },
    { "scope": ["constant.character"], "settings": { "foreground": "#E6DB74" } },

    { "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier", "keyword.operator.logical", "keyword.operator.word", "keyword.operator.new", "keyword.operator.expression", "keyword.other", "keyword.control.import", "keyword.control.flow"], "settings": { "foreground": "#F92672", "fontStyle": "bold" } },
    { "scope": ["keyword.operator", "punctuation.separator.annotation", "punctuation.separator.key-value"], "settings": { "foreground": "#F92672", "fontStyle": "" } },
    { "scope": ["keyword.operator.logical.python", "keyword.operator.word.python"], "settings": { "foreground": "#F92672", "fontStyle": "bold" } },

    { "scope": ["entity.name.function", "meta.function-call.generic", "support.function", "entity.name.function.member", "meta.method-call"], "settings": { "foreground": "#A6E22E" } },
    { "scope": ["support.function.builtin", "support.function.builtin.python", "support.function.magic"], "settings": { "foreground": "#66D9EF", "fontStyle": "italic" } },
    { "scope": ["entity.name.function.decorator", "meta.function.decorator", "punctuation.definition.decorator", "meta.attribute", "entity.other.attribute-name.pragma", "meta.preprocessor", "keyword.control.directive"], "settings": { "foreground": "#C4BE89", "fontStyle": "italic" } },

    { "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "support.class", "storage.type.class.python", "entity.name.type.class"], "settings": { "foreground": "#66D9EF", "fontStyle": "" } },
    { "scope": ["storage.type.class.python", "storage.type.function.python", "storage.type.function.async.python"], "settings": { "foreground": "#F92672", "fontStyle": "bold" } },
    { "scope": ["support.type.python", "support.type.builtin", "support.type.primitive", "storage.type.primitive", "storage.type.built-in"], "settings": { "foreground": "#66D9EF", "fontStyle": "italic" } },
    { "scope": ["entity.name.namespace", "entity.name.type.module", "support.other.namespace", "entity.name.scope-resolution"], "settings": { "foreground": "#66D9EF" } },
    { "scope": ["support.type.exception", "support.class.exception"], "settings": { "foreground": "#66D9EF", "fontStyle": "italic" } },

    { "scope": ["variable.language", "variable.language.special.self.python", "variable.parameter.function.language.special.self.python", "variable.parameter.function.language.special.cls.python"], "settings": { "foreground": "#66D9EF", "fontStyle": "italic" } },
    { "scope": ["variable", "variable.other", "variable.parameter", "variable.other.readwrite", "meta.function.parameters", "variable.parameter.function"], "settings": { "foreground": "#E0E2EA" } },
    { "scope": ["variable.other.property", "variable.other.object.property", "meta.attribute.python", "variable.other.member", "support.variable.property"], "settings": { "foreground": "#E0E2EA" } },
    { "scope": ["support.variable.magic", "variable.language.special"], "settings": { "foreground": "#66D9EF", "fontStyle": "italic" } },

    { "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator", "punctuation.section", "punctuation.parenthesis", "punctuation.definition.parameters", "punctuation.definition.arguments", "punctuation.definition.list"], "settings": { "foreground": "#8F8F8F" } },
    { "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded", "storage.type.format", "constant.character.format"], "settings": { "foreground": "#66D9EF", "fontStyle": "italic" } },

    { "scope": ["entity.name.tag"], "settings": { "foreground": "#F92672", "fontStyle": "italic" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#A6E22E" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#EF5939", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#808080", "fontStyle": "underline" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"], "settings": { "foreground": "#E6DB74" } },
    { "scope": ["markup.list punctuation.definition.list", "beginning.punctuation.definition.list"], "settings": { "foreground": "#F92672" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#A6E22E" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#F92672" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#FD971F" } },

    { "scope": ["support.type.property-name.json", "support.type.property-name"], "settings": { "foreground": "#FD971F" } },
    { "scope": ["comment.line.todo", "keyword.codetag.notation", "keyword.other.todo"], "settings": { "foreground": "#FFFFFF", "fontStyle": "bold" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#E6DB74", "background": "#1E0010" } },
    { "scope": ["invalid.deprecated"], "settings": { "foreground": "#FFFFFF", "background": "#333333" } }
  ],

  "semanticTokenColors": {
    "class": "#66D9EF",
    "class.defaultLibrary": { "foreground": "#66D9EF", "italic": true },
    "type": "#66D9EF",
    "type.defaultLibrary": { "foreground": "#66D9EF", "italic": true },
    "typeParameter": "#66D9EF",
    "enum": "#66D9EF",
    "interface": "#66D9EF",
    "struct": "#66D9EF",
    "namespace": "#66D9EF",
    "module": "#66D9EF",
    "enumMember": { "foreground": "#AE81FF", "bold": true },
    "function": "#A6E22E",
    "function.defaultLibrary": { "foreground": "#66D9EF", "italic": true },
    "method": "#A6E22E",
    "builtinFunction": { "foreground": "#66D9EF", "italic": true },
    "decorator": { "foreground": "#C4BE89", "italic": true },
    "macro": { "foreground": "#C4BE89", "italic": true },
    "parameter": "#E0E2EA",
    "variable": "#E0E2EA",
    "variable.readonly": "#E0E2EA",
    "variable.defaultLibrary": { "foreground": "#66D9EF", "italic": true },
    "selfParameter": { "foreground": "#66D9EF", "italic": true },
    "clsParameter": { "foreground": "#66D9EF", "italic": true },
    "property": "#FD971F",
    "keyword": { "foreground": "#F92672", "bold": true },
    "string": "#E6DB74",
    "number": "#AE81FF",
    "comment": "#7E8E91",
    "operator": "#F92672"
  }
}
