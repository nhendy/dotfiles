// Shared by Cursor and VS Code. Only keys that nvim (vscode-neovim) never sees:
// global pane navigation, the file explorer, terminal, pickers, insert-mode AI
// accept. Everything else (vv, vs, ,nn, ,r, gd, ...) is in nvim keymaps.lua.
//
// Later entries win when several match, so specific contexts come last.
[
  // ── C-h/j/k/l: move focus between editor splits, explorer, terminal, panels ─
  // Like vim-tmux-navigator: one gesture from anywhere. Not in insert/cmdline
  // mode, so nvim keeps <C-h> (backspace) etc. while typing.
  {
    "key": "ctrl+h",
    "command": "workbench.action.navigateLeft",
    "when": "(editorTextFocus && neovim.mode != 'insert' && neovim.mode != 'cmdline') || terminalFocus || filesExplorerFocus || ((sideBarFocus || panelFocus || auxiliaryBarFocus) && !inputFocus)"
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.navigateRight",
    "when": "(editorTextFocus && neovim.mode != 'insert' && neovim.mode != 'cmdline') || terminalFocus || filesExplorerFocus || ((sideBarFocus || panelFocus || auxiliaryBarFocus) && !inputFocus)"
  },
  {
    "key": "ctrl+j",
    "command": "workbench.action.navigateDown",
    "when": "(editorTextFocus && neovim.mode != 'insert' && neovim.mode != 'cmdline') || terminalFocus || filesExplorerFocus || ((sideBarFocus || panelFocus || auxiliaryBarFocus) && !inputFocus)"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.navigateUp",
    "when": "(editorTextFocus && neovim.mode != 'insert' && neovim.mode != 'cmdline') || terminalFocus || filesExplorerFocus || ((sideBarFocus || panelFocus || auxiliaryBarFocus) && !inputFocus)"
  },

  // ── C-f: fuzzy file picker (nvim's fzf :Files) ────────────────────────────
  // vscode-neovim hard-wires ctrl+f to its own page-scroll command, so the key
  // never reaches nvim's <C-f> mapping; bind it here instead.
  {
    "key": "ctrl+f",
    "command": "workbench.action.quickOpen",
    "when": "editorTextFocus && neovim.mode != 'insert' && neovim.mode != 'cmdline'"
  },

  // ── Terminal toggles ───────────────────────────────────────────────────────
  // Ctrl-; jumps editor <-> bottom terminal (opens it if closed).
  { "key": "ctrl+;", "command": "workbench.action.terminal.focus", "when": "!terminalFocus" },
  { "key": "ctrl+;", "command": "workbench.action.focusActiveEditorGroup", "when": "terminalFocus" },
  // Ctrl-/ shows/hides the bottom terminal panel.
  { "key": "ctrl+/", "command": "workbench.action.terminal.toggleTerminal" },

  // ── Split sizing / direct group focus ──────────────────────────────────────
  { "key": "ctrl+up", "command": "workbench.action.increaseViewHeight", "when": "editorTextFocus && neovim.mode == 'normal'" },
  { "key": "ctrl+down", "command": "workbench.action.decreaseViewHeight", "when": "editorTextFocus && neovim.mode == 'normal'" },
  { "key": "ctrl+left", "command": "workbench.action.decreaseViewWidth", "when": "editorTextFocus && neovim.mode == 'normal'" },
  { "key": "ctrl+right", "command": "workbench.action.increaseViewWidth", "when": "editorTextFocus && neovim.mode == 'normal'" },
  { "key": "ctrl+1", "command": "workbench.action.focusFirstEditorGroup" },
  { "key": "ctrl+2", "command": "workbench.action.focusSecondEditorGroup" },
  { "key": "ctrl+3", "command": "workbench.action.focusThirdEditorGroup" },
  { "key": "ctrl+4", "command": "workbench.action.focusFourthEditorGroup" },
  { "key": "ctrl+5", "command": "workbench.action.focusFifthEditorGroup" },

  // ── Move lines (nvim <M-j>/<M-k>); works in every mode ─────────────────────
  { "key": "alt+j", "command": "editor.action.moveLinesDownAction", "when": "editorTextFocus && !editorReadonly" },
  { "key": "alt+k", "command": "editor.action.moveLinesUpAction", "when": "editorTextFocus && !editorReadonly" },

  // ── Insert mode: accept AI ghost text like supermaven (<C-l>, <M-w>) ──────
  { "key": "ctrl+l", "command": "editor.action.inlineSuggest.commit", "when": "inlineSuggestionVisible && editorTextFocus && neovim.mode == 'insert'" },
  { "key": "alt+w", "command": "editor.action.inlineSuggest.acceptNextWord", "when": "inlineSuggestionVisible && editorTextFocus && neovim.mode == 'insert'" },

  // ── File explorer: NERDTree keys ──────────────────────────────────────────
  { "key": "j", "command": "list.focusDown", "when": "filesExplorerFocus && !inputFocus" },
  { "key": "k", "command": "list.focusUp", "when": "filesExplorerFocus && !inputFocus" },
  { "key": "h", "command": "list.collapse", "when": "filesExplorerFocus && !inputFocus" },
  { "key": "x", "command": "list.collapse", "when": "filesExplorerFocus && !inputFocus" },
  { "key": "shift+x", "command": "workbench.files.action.collapseExplorerFolders", "when": "filesExplorerFocus && !inputFocus" },
  { "key": "l", "command": "list.select", "when": "filesExplorerFocus && !inputFocus" },
  { "key": "o", "command": "list.select", "when": "filesExplorerFocus && !inputFocus" },
  { "key": "s", "command": "explorer.openToSide", "when": "filesExplorerFocus && !inputFocus" },
  { "key": "a", "command": "explorer.newFile", "when": "filesExplorerFocus && !inputFocus" },
  { "key": "shift+a", "command": "explorer.newFolder", "when": "filesExplorerFocus && !inputFocus" },
  { "key": "r", "command": "renameFile", "when": "filesExplorerFocus && !inputFocus && !explorerResourceIsRoot" },
  { "key": "d", "command": "deleteFile", "when": "filesExplorerFocus && !inputFocus && !explorerResourceIsRoot" },
  { "key": "shift+r", "command": "workbench.files.action.refreshFilesExplorer", "when": "filesExplorerFocus && !inputFocus" },
  { "key": "y y", "command": "copyRelativeFilePath", "when": "filesExplorerFocus && !inputFocus" },
  { "key": "q", "command": "workbench.action.closeSidebar", "when": "filesExplorerFocus && !inputFocus" },

  // ── j/k in other lists (search results, problems, references) ─────────────
  { "key": "j", "command": "list.focusDown", "when": "listFocus && !inputFocus && !filesExplorerFocus" },
  { "key": "k", "command": "list.focusUp", "when": "listFocus && !inputFocus && !filesExplorerFocus" },

  // ── Pickers and completion: C-j/C-k move the selection (fzf feel) ─────────
  // Last so they win over the navigate bindings above.
  { "key": "ctrl+j", "command": "workbench.action.quickOpenSelectNext", "when": "inQuickOpen" },
  { "key": "ctrl+k", "command": "workbench.action.quickOpenSelectPrevious", "when": "inQuickOpen" },
  { "key": "ctrl+j", "command": "selectNextSuggestion", "when": "suggestWidgetVisible && textInputFocus" },
  { "key": "ctrl+k", "command": "selectPrevSuggestion", "when": "suggestWidgetVisible && textInputFocus" },
  { "key": "ctrl+j", "command": "selectNextCodeAction", "when": "codeActionMenuVisible" },
  { "key": "ctrl+k", "command": "selectPrevCodeAction", "when": "codeActionMenuVisible" }
]
